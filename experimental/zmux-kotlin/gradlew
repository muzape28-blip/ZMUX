#!/bin/bash
gradle "$@" > build_output.log 2>&1
exit_code=$?
if [ $exit_code -ne 0 ]; then
    echo "### ❌ Compile Error" >> $GITHUB_STEP_SUMMARY
    echo '```text' >> $GITHUB_STEP_SUMMARY
    tail -n 100 build_output.log >> $GITHUB_STEP_SUMMARY
    echo '```' >> $GITHUB_STEP_SUMMARY
    exit 1
fi
exit 0