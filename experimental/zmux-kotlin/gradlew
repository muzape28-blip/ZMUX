#!/usr/bin/env bash
# This repository intentionally delegates to the Gradle installation supplied by
# Android Studio/CI. Keep a local transcript, but stream it too: redirecting all
# output to a file hid the actionable Kotlin/Chaquopy error from GitHub Actions.
set -o pipefail

gradle "$@" 2>&1 | tee error.log
exit_code=${PIPESTATUS[0]}
exit "$exit_code"
