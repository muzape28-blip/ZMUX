<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zmux_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zmux_bar"
        android:orientation="horizontal"
        android:padding="4dp">

        <EditText
            android:id="@+id/url_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/ws_url_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:textColor="@color/zmux_fg"
            android:textSize="12sp" />

        <Button
            android:id="@+id/connect_button"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zmux_bar"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/zmux_fg"
        android:textSize="11sp"
        android:visibility="gone" />

    <com.zmux.terminal.ZmuxTerminalView
        android:id="@+id/terminal_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/zmux_bg" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zmux_bar"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/key_esc" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESC" />
            <Button android:id="@+id/key_ctrl" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CTRL" />
            <Button android:id="@+id/key_alt" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALT" />
            <Button android:id="@+id/key_tab" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TAB" />
            <Button android:id="@+id/key_ctrl_c" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="^C" />
            <Button android:id="@+id/key_left" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="←" />
            <Button android:id="@+id/key_down" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↓" />
            <Button android:id="@+id/key_up" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑" />
            <Button android:id="@+id/key_right" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" />
            <Button android:id="@+id/key_kb" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KB" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
