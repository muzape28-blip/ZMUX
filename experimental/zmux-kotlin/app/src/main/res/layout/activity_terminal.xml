<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zmux_bg"
    android:orientation="vertical">

    <!-- Connect bar: host / port / token. Port and token are runtime values on the
         Python side (server.py picks the port, security.py generates the token). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zmux_bar"
        android:orientation="horizontal"
        android:padding="4dp">

        <EditText
            android:id="@+id/host_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:hint="@string/host_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="@color/zmux_fg"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/port_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:hint="@string/port_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:textColor="@color/zmux_fg"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/token_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:hint="@string/token_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:textColor="@color/zmux_fg"
            android:textSize="12sp" />

        <Button
            android:id="@+id/connect_button"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zmux_bar"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/zmux_fg"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Session tabs, driven by the backend's {"type":"sessions"} frames. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zmux_bar"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tab_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/new_session_button"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_session" />
    </LinearLayout>

    <com.zmux.terminal.ZmuxTerminalView
        android:id="@+id/terminal_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/zmux_bg" />

    <!-- Virtual keys are built in code from ZmuxKeys.ROWS (ported from terminal.html). -->
    <LinearLayout
        android:id="@+id/virtual_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zmux_bar"
        android:orientation="vertical" />
</LinearLayout>
