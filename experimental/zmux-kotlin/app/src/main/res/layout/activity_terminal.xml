<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zmux_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Chrome row: brand mark, status pill, connect toggle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/zmux_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/brand_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="@string/brand"
                android:textColor="@color/zmux_ember"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.zmux.terminal.widget.StatusPillView
                android:id="@+id/status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/zmux_outline" />

        <!-- Session tabs, driven by {"type":"sessions"} frames. -->
        <LinearLayout
            android:id="@+id/tab_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/zmux_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingBottom="4dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tab_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/new_session_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ghost_button"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/new_session"
                android:textColor="@color/zmux_text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <com.termux.view.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/zmux_bg" />

        <!-- Virtual keys are built in code from ZmuxKeys.ROWS. -->
        <LinearLayout
            android:id="@+id/virtual_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/zmux_surface"
            android:orientation="vertical"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Boot overlay completely hidden for local shell mode -->
    <LinearLayout
        android:id="@+id/boot_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/zmux_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <com.zmux.terminal.widget.BootBrandView
            android:id="@+id/boot_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/host_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2.4"
                android:background="@drawable/bg_field"
                android:fontFamily="monospace"
                android:hint="@string/host_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:paddingVertical="9dp"
                android:textColor="@color/zmux_text"
                android:textColorHint="@color/zmux_text_dim"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/port_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:fontFamily="monospace"
                android:hint="@string/port_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:paddingVertical="9dp"
                android:textColor="@color/zmux_text"
                android:textColorHint="@color/zmux_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/token_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:fontFamily="monospace"
            android:hint="@string/token_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:paddingHorizontal="10dp"
            android:paddingVertical="9dp"
            android:textColor="@color/zmux_text"
            android:textColorHint="@color/zmux_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/boot_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text="@string/boot_hint"
            android:textColor="@color/zmux_text_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/boot_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary_button"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingVertical="13dp"
            android:text="@string/attach"
            android:textColor="@color/zmux_bg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
